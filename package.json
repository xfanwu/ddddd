{
  "name": "dung",
  "version": "1.6.2",
  "private": true,
  "description": "Paste a link, it downloads. A tiny download manager with a pixel dung beetle, powered by a bundled aria2",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor-aria2.js",
    "dist": "node scripts/vendor-aria2.js && electron-builder --mac",
    "test:ui": "node scripts/ui-e2e.js",
    "test:app": "node scripts/app-e2e.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "com.local.dung",
    "productName": "Dung",
    "icon": "build/icon.icns",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "scripts/after-pack.js"
  }
}
